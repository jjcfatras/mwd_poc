{
  "extends": ["//"],
  "tasks": {
    "build": {
      "dependsOn": ["build:styles:nf"]
    },
    "build:styles:nf": {
      "outputs": ["dist/**"]
    },

    "dev": {
      "with": ["dev:styles:nf", "dev:components"]
    },
    "dev:styles:nf": {
      "cache": false,
      "persistent": true
    },
    "dev:components": {
      "cache": false,
      "persistent": true
    }
  }
}
