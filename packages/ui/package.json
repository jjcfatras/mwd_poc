{
  "name": "@repo/ui",
  "version": "0.0.0",
  "private": true,
  "exports": {
    "./components*": "./src/components/*.tsx",
    "./theming*": "./src/theming/*.ts",
    "./styles": "./dist/styles.css"
  },
  "scripts": {
    "lint": "eslint --fix",
    "generate:component": "turbo gen react-component",
    "check-types": "tsc --noEmit",
    "dev:styles": "tailwindcss -i ./globals.css -o ./dist/styles.css --watch",
    "build:styles": "tailwindcss -i ./globals.css -o ./dist/styles.css"
  },
  "devDependencies": {
    "@chakra-ui/cli": "^3.22.0",
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@repo/tailwind-config": "workspace:*",
    "@types/node": "^22.15.3",
    "@types/react": "19.1.0",
    "@types/react-dom": "19.1.1",
    "eslint": "^9.30.0",
    "typescript": "5.8.2"
  },
  "dependencies": {
    "@chakra-ui/react": "^3.22.0",
    "@emotion/react": "^11.14.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "next-themes": "^0.4.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-icons": "^5.5.0",
    "tailwind-merge": "^3.3.1",
    "@tailwindcss/cli": "^4.1.11",
    "@tailwindcss/postcss": "^4.1.11",
    "tailwindcss": "^4.1.11"
  },
  "type": "module"
}
